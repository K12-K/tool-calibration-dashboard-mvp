# ---- Copy to .env and edit before running `docker compose up -d --build` ----

# "development" for testing on your own machine; "production" on the client server.
# In production the app refuses to start with a weak SECRET_KEY and hides /api/docs.
ENVIRONMENT=development

# Port the web app is published on (browse to http://<server>:HTTP_PORT)
HTTP_PORT=8080

# Database (use letters/digits only in the password, or URL-encode special characters)
POSTGRES_DB=calibration
POSTGRES_USER=calibration
POSTGRES_PASSWORD=change_this_db_password

# Long random string used to sign login tokens:   openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_string_of_at_least_32_chars

# Time zone of the plant (IANA name, e.g. America/Chicago, Asia/Kolkata). Affects "days left".
TZ=UTC

# Sign-up controls
ALLOW_REGISTRATION=true
# Only allow these email domains to register (comma separated). Empty = any domain.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=

# Name shown inside the authenticator app
TOTP_ISSUER=Calibration Log

# Login session length in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
